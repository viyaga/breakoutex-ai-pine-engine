{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "src/scripts/audit-candle-parity.ts",
    "src/scripts/debug-align.ts",
    "src/scripts/debug-bar-73.ts",
    "src/scripts/debug-candle-parity.ts",
    "src/scripts/debug-donchian-parity.ts",
    "src/scripts/test-cross-engine-parity.ts",
    "src/scripts/test-all-existing-pine.ts"
  ]
}
